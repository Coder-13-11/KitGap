# Copy to .env.local for local development. Never commit real values.

# Server-only Postgres connection string (Supabase: Project Settings > Database).
# For deployments use the transaction pooler URL (port 6543).
DATABASE_URL=

# Supabase project URL and publishable (anon) key. These are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of this app, used in confirmation and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only random secret (32+ characters) that signs demo sandbox cookies.
DEMO_COOKIE_SECRET=

# Optional: number of database connections per server instance (default 5).
DATABASE_POOL_SIZE=

# Kit, the AI helper (optional). Any OpenAI-compatible endpoint. Without
# these, Kit still works from written rules, and voice uses the browser.
KIT_AI_BASE_URL=
KIT_AI_API_KEY=
KIT_AI_MODEL=gemma-4-31b-it
# Optional voice models on the same endpoint:
# KIT_AI_STT_MODEL=whisper-large-v3
# KIT_AI_VOICE_MODEL=kokoro
# KIT_AI_VOICE=af_heart
